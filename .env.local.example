# OpenAI - Used for Whisper (speech-to-text), GPT-4o (translation), and TTS (text-to-speech)
OPENAI_API_KEY=sk-...

# Deepgram - Used for ultra-accurate transcription and speaker diarization (gender detection setup)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs - Used for ultra-natural, human-like voice synthesis (male/female tracking)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# HuggingFace - Used for Khmer, Lao, and Burmese TTS (OpenAI TTS doesn't support these)
# Get a free token at: https://huggingface.co/settings/tokens (Read access is enough)
HF_API_TOKEN=hf_...

# Upload directory (defaults to ./uploads if not set)
UPLOAD_DIR=./uploads
