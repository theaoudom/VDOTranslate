# OpenAI - Used for Whisper (speech-to-text), GPT-4o (translation), and TTS (text-to-speech)
OPENAI_API_KEY=sk-...

# Deepgram - Used for ultra-accurate transcription and speaker diarization (gender detection setup)
DEEPGRAM_API_KEY=your_deepgram_api_key

# ElevenLabs - Used for ultra-natural, human-like voice synthesis (per-character voices)
# Also powers "Real Character Voices": each speaker's voice is cloned from the original
# video so the dub keeps their real voice. Instant Voice Cloning needs a Starter plan or above.
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# HuggingFace - Used for Khmer, Lao, and Burmese TTS (OpenAI TTS doesn't support these)
# Get a free token at: https://huggingface.co/settings/tokens (Read access is enough)
HF_API_TOKEN=hf_...

# Supabase - accounts, login and credits (Project Settings → API in the Supabase dashboard)
# Then run supabase/migrations/0001_profiles_and_credits.sql in the SQL Editor once.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Site URL used in email links (confirm email, reset password)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Upload directory (defaults to ./uploads if not set)
UPLOAD_DIR=./uploads

# Azure Speech - "Natural AI voice" (incl. Khmer). Portal → Speech services → Keys and Endpoint
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=southeastasia

# Payments - KHQR / bank transfer, approved by the team in Telegram
# Bot token from @BotFather (can be shared with another app: the bot only sends messages);
# your chat id from @userinfobot
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_ADMIN_CHAT_ID=123456789
# Any long random string: signs the Approve / Reject links. Same value on Vercel.
PAYMENT_LINK_SECRET=change_me
# Shown in the pay window (the KHQR picture goes in assets/khqr.png)
PAY_BANK=ABA Bank
PAY_ACCOUNT_NAME=YOUR NAME
PAY_ACCOUNT_NUMBER=000 000 000
